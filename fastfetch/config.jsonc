{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/Pictures/System/shell.png",
    "type": "kitty",
    "height": 20,
    "padding": {
      "bottom": 3,
    },
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "magenta",
      "title": "blue",
    },
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "host",
      "key": "Machine  ",
      "keyColor": "blue",
    },
    {
      "type": "uptime",
      "key": "Uptime   ",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "Packages ",
      "keyColor": "blue",
    },
    "break",
    {
      "type": "shell",
      "key": "Shell    ",
      "keyColor": "cyan",
    },
    {
      "type": "display",
      "key": "Display  ",
      "keyColor": "cyan",
    },
    {
      "type": "wm",
      "key": "WM       ",
      "keyColor": "cyan",
    },
    {
      "type": "terminal",
      "key": "Terminal ",
      "keyColor": "cyan",
    },
    "break",
    {
      "type": "cpu",
      "key": "CPU      ",
      "keyColor": "yellow",
    },
    {
      "type": "gpu",
      "key": "GPU      ",
      "keyColor": "yellow",
    },
    {
      "type": "memory",
      "key": "RAM      ",
      "keyColor": "yellow",
    },
    {
      "type": "disk",
      "key": "Disk     ",
      "keyColor": "yellow",
    },
    {
      "type": "battery",
      "key": "Battery  ",
      "keyColor": "yellow",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
